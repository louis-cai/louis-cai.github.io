---
import { SITE_TITLE } from '../consts';
interface Props {
  title?: string;
  description?: string;
}
const { title = SITE_TITLE, description = 'Louis Cai — I build things. Some of them die. Here is why.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <style>
    :root { --ink:#222; --paper:#fafaf8; --muted:#777; --line:#e4e4e0; --blood:#8b0000; }
    * { box-sizing: border-box; }
    body { margin:0; font: 17px/1.7 -apple-system, "Segoe UI", Roboto, sans-serif; color:var(--ink); background:var(--paper); }
    .wrap { max-width:760px; margin:0 auto; padding:48px 24px 80px; }
    a { color:var(--blood); text-decoration:none; }
    a:hover { text-decoration:underline; }
    nav.top { border-bottom:1px solid var(--line); padding:0 24px; }
    nav.top .inner { max-width:760px; margin:0 auto; display:flex; gap:20px; padding:14px 0; font-size:15px; }
    .muted { color:var(--muted); font-size:14px; }
    h1 { font-size:34px; line-height:1.25; letter-spacing:-.5px; margin:0 0 8px; }
    h2 { font-size:24px; margin:40px 0 12px; }
    ul.posts { list-style:none; padding:0; margin:0; }
    ul.posts li { padding:10px 0; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; gap:16px; align-items:baseline; }
    ul.posts .d { color:var(--muted); font-size:13px; white-space:nowrap; }
    article .meta { color:var(--muted); font-size:14px; margin-bottom:32px; }
    article img { max-width:100%; height:auto; }
    article pre { overflow-x:auto; padding:16px; background:#fff; border:1px solid var(--line); border-radius:6px; font-size:14px; }
    article blockquote { margin:0; padding:2px 20px; border-left:3px solid var(--line); color:var(--muted); }
    article h2 { border-bottom:1px solid var(--line); padding-bottom:6px; }
    footer { margin-top:64px; border-top:1px solid var(--line); padding-top:20px; color:var(--muted); font-size:13px; }
  </style>
</head>
<body>
  <nav class="top"><div class="inner">
    <a href="/">Home</a>
    <a href="/postmortems/mailielts.html">Autopsy #001</a>
    <a href="/archive/">Archive</a>
  </div></nav>
  <div class="wrap">
    <slot />
    <footer>© {new Date().getFullYear()} Louis Cai · built with Astro · deployed by GitHub Actions</footer>
  </div>
</body>
</html>